{
  "manifest_version": 3,
  "name": "Call Translator",
  "version": "0.1.10",
  "description": "Двусторонний перевод Google Meet с локальной озвучкой. Технический пилот.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage", "downloads",
    "nativeMessaging", "activeTab", "scripting", "tabCapture", "offscreen"
  ],
  "host_permissions": ["https://meet.google.com/*", "https://ppsbot.pp.ua/*"],
  "web_accessible_resources": [{"resources":["pcm-worklet.js"],"matches":["https://meet.google.com/*"]}],
  "content_scripts": [
    {"matches":["https://meet.google.com/*"],"js":["pcm.js","meet.js","translate.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://meet.google.com/*"],"js":["bridge.js"],"run_at":"document_start","world":"ISOLATED"}
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
