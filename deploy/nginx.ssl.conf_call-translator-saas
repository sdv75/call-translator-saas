# Managed by Call Translator SaaS deployment.
location = /call-translator-saas {
    return 302 /call-translator-saas/;
}
location ^~ /call-translator-saas/ {
    proxy_pass http://127.0.0.1:5086;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    # Hestia's parent config hides Upgrade; explicitly pass it for WebSockets.
    proxy_pass_header Upgrade;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_buffering off;
    client_max_body_size 8k;
    # OAuth callbacks must not be recorded with query-string authorization codes.
    access_log off;
}
